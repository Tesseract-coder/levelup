# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=
# Model used for food/activity parsing and summary phrasing.
ANTHROPIC_MODEL=claude-opus-5-5
# AI proxy port (Vite dev server proxies /api to it)
PORT=8787
# Comma-separated list of allowed origins in production (optional)
CORS_ORIGIN=
# Requests per minute per IP for /api/*
RATE_LIMIT_PER_MIN=30
